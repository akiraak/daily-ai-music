# リポジトリ直下に .env としてコピーして値を設定する

# kie.ai(sunoapi.org 互換)の API キー
SUNOAPI_ORG_KEY=
SUNOAPI_BASE_URL=https://api.kie.ai

# LLM 生成パイプライン用(音楽生成エンジン)
ANTHROPIC_API_KEY=

# /api/* 認証用 secret(16 文字以上、[A-Za-z0-9_-] のみ)。生成例: openssl rand -hex 16
API_SECRET=

# 公開ページの絶対 URL のベース(OGP の og:url / og:image 用)。本番は https://music.chobi.me
# 未設定なら http://localhost:<PORT>
PUBLIC_BASE_URL=
